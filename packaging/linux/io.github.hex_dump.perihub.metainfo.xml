<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.hex_dump.perihub</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>PeriHub</name>
  <summary>Configure gaming keyboards and mice without the vendors' apps</summary>
  <developer id="io.github.hex_dump">
    <name>hex-dump</name>
  </developer>

  <description>
    <p>
      PeriHub configures SteelSeries, Logitech and Corsair keyboards and mice without SteelSeries GG,
      Logitech G HUB or Corsair iCUE. It has no account and no telemetry, and it never touches firmware.
    </p>
    <ul>
      <li>SteelSeries Apex 3 TKL: lighting with reactive effects, brightness and key remapping</li>
      <li>Logitech G mice with onboard memory: profiles, DPI, polling rate, buttons, lighting and macros, saved in the mouse</li>
      <li>Logitech G300: its three profiles</li>
      <li>Logitech devices on a Bolt or Unifying receiver: battery, and DPI as an experimental setting</li>
      <li>Corsair mice and keyboards: firmware, polling rate and DPI, with experimental lighting</li>
      <li>App profiles that switch lighting and mouse profile with the game in focus, and software macros</li>
      <li>A backup before every write to a device</li>
    </ul>
    <p>
      Untested devices are only read until someone confirms them: each device page offers a test report.
    </p>
    <p>
      PeriHub needs a udev rule to reach the devices, which a Flatpak cannot install by itself. The project
      page gives the one-line command to install it.
    </p>
  </description>

  <launchable type="desktop-id">io.github.hex_dump.perihub.desktop</launchable>

