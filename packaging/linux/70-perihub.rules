# PeriHub: give the user with the active session access to the HID configuration interfaces.
# Manual install:
#   sudo cp 70-perihub.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger

# Interface numbers (most systems already import them in 60-persistent-hidraw.rules).
KERNEL=="hidraw*", SUBSYSTEMS=="usb", ENV{ID_USB_INTERFACE_NUM}=="", IMPORT{builtin}="usb_id"

# SteelSeries Apex 3 TKL: only the configuration interface (lighting, brightness, key mapping).
# The interfaces that report key presses stay closed: see 71-perihub-keys.rules.
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1622", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="uaccess"
# Logitech mice (the G502 HERO is tested, the others are read-only until they are)
# Logitech G502 HERO
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08b", TAG+="uaccess"
# Logitech G502 Proteus Core
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c07d", TAG+="uaccess"
# Logitech G502 Proteus Spectrum
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c332", TAG+="uaccess"
# Logitech G502 HERO Wireless
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08d", TAG+="uaccess"
# Logitech G502 X
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c099", TAG+="uaccess"
# Logitech G502 X Wireless
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c098", TAG+="uaccess"
# Logitech G502 X PLUS
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c095", TAG+="uaccess"
# Logitech G Pro
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c085", TAG+="uaccess"
# Logitech G Pro
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08c", TAG+="uaccess"
# Logitech G Pro Wireless
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c088", TAG+="uaccess"
# Logitech G Pro X Superlight
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c094", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c084", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c092", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c09d", TAG+="uaccess"
# Logitech G302
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c07f", TAG+="uaccess"
# Logitech G303
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c080", TAG+="uaccess"
# Logitech G303 Shroud Edition
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c097", TAG+="uaccess"
# Logitech G402
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c07e", TAG+="uaccess"
# Logitech G403
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c083", TAG+="uaccess"
# Logitech G403 HERO
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08f", TAG+="uaccess"
# Logitech G403 Wireless
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c082", TAG+="uaccess"
# Logitech G703
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c087", TAG+="uaccess"
# Logitech G703 HERO
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c090", TAG+="uaccess"
# Logitech G705
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c096", TAG+="uaccess"
# Logitech G900
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c081", TAG+="uaccess"
# Logitech G903
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c086", TAG+="uaccess"
# Logitech G903 HERO
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c091", TAG+="uaccess"
# Logitech MX518
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08e", TAG+="uaccess"

# LIGHTSPEED receivers, for wireless Logitech mice (read-only until they are tested): only the
# receiver's own HID++ interface (02). Movements and typing arrive on its other interfaces, which
# stay closed, and so do the devices that Linux creates for the mice paired with it.
KERNEL=="hidraw*", KERNELS=="0003:046D:C539.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C53A.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C53D.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C53F.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C541.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C543.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C545.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C547.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0003:046D:C54D.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
# Logi Bolt receiver: PeriHub only reads what is paired with it, for test reports.
KERNEL=="hidraw*", KERNELS=="0003:046D:C548.*", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
# Unifying receivers (c52b, c532) are left out on purpose. Linux puts them in DJ mode, where what is
# typed on the keyboards paired with them arrives on the same interface as HID++ (02): opening it
# to the user would let any program running as the user read that typing. PeriHub offers the
# optional 73-perihub-unifying.rules, with that warning, and reads them where another rule already
# opens them, such as Solaar's.
# Logitech G300 (read only): interface 1, which holds its profiles. It also has a keyboard collection,
# which sends only the keys assigned to the mouse's own buttons.
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c246", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="uaccess"
# Corsair mice (experimental, untested), on their USB cable: only the control interface; the others report movements and clicks.
# Corsair KATAR PRO
KERNEL=="hidraw*", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1b93", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="uaccess"
