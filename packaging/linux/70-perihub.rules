# Logitech G Pro X Superlight
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c094", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c084", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c092", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c09d", TAG+="uaccess"
