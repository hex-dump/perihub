# PeriHub: give the user with the active session access to the HID configuration interfaces.
# Manual install:
#   sudo cp 70-perihub.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger

# Interface numbers (most systems already import them in 60-persistent-hidraw.rules).
KERNEL=="hidraw*", SUBSYSTEMS=="usb", ENV{ID_USB_INTERFACE_NUM}=="", IMPORT{builtin}="usb_id"

# SteelSeries Apex 3 TKL: only the configuration interface (lighting, brightness, key mapping).
# The interfaces that report key presses stay closed: see 71-perihub-keys.rules.
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1622", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="uaccess"
# Logitech mice (the G502 HERO is tested, the others are read-only until they are)
# Logitech G502 HERO
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08b", TAG+="uaccess"
# Logitech G502 Proteus Core
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c07d", TAG+="uaccess"
# Logitech G502 Proteus Spectrum
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c332", TAG+="uaccess"
# Logitech G502 HERO Wireless
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08d", TAG+="uaccess"
# Logitech G502 X
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c099", TAG+="uaccess"
# Logitech G502 X Wireless
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c098", TAG+="uaccess"
# Logitech G502 X PLUS
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c095", TAG+="uaccess"
# Logitech G Pro
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c085", TAG+="uaccess"
# Logitech G Pro
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c08c", TAG+="uaccess"
# Logitech G Pro Wireless
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c088", TAG+="uaccess"
# Logitech G Pro X Superlight
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c094", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c084", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c092", TAG+="uaccess"
# Logitech G102/G103/G203
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c09d", TAG+="uaccess"
# Logitech G302
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c07f", TAG+="uaccess"
# Logitech G303
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c080", TAG+="uaccess"
# Logitech G303 Shroud Edition
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c097", TAG+="uaccess"
# Logitech G402
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c07e", TAG+="uaccess"
# Logitech G403
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c083", TAG+="uaccess"
# Logitech G403 HERO
