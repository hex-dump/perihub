{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeriHub",
  "version": "0.5.1",
  "identifier": "io.github.hexdump.perihub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PeriHub",
        "width": 1160,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "hex-dump",
    "homepage": "https://github.com/hex-dump/perihub",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Configure gaming peripherals without SteelSeries GG or Logitech G HUB",
    "longDescription": "Open-source app to configure the SteelSeries Apex 3 TKL keyboard and Logitech G mice on Windows and Linux: lighting, key remapping, DPI, buttons and onboard profiles.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": { "files": { "/usr/lib/udev/rules.d/70-perihub.rules": "../../packaging/linux/70-perihub.rules" } },
      "rpm": { "files": { "/usr/lib/udev/rules.d/70-perihub.rules": "../../packaging/linux/70-perihub.rules" } }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNjhBMTE3MjZDMkJGNzcKUldSM3Y4SW1GNkZvUGhsbmdkWFE2L2l2LzZoSnBidGhZcEloM1pKam5UcHdkS29NaUduT1JiYWcK",
      "endpoints": ["https://github.com/hex-dump/perihub/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
